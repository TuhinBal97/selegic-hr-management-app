<apex:page controller="PayrollDocumentPdfController" renderAs="pdf" showHeader="false" sidebar="false" standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false">
    <html>
        <head>
            <meta charset="UTF-8"/>
            <style type="text/css">
                @page { size: A4; margin: {!IF(isPayslip, '10mm 8mm', '16mm 14mm')}; }
                body { font-family: Arial, Helvetica, sans-serif; color: #181818; font-size: 10pt; }
                table { width: 100%; border-collapse: collapse; }
                .brand { font-size: 20pt; font-weight: bold; }
                .green { color: #4caf5a; }
                .muted { color: #686868; }
                .invoice-head td { vertical-align: bottom; padding: 8px; }
                .invoice-title { font-size: 23pt; text-align: right; }
                .invoice-box { border: 1px solid #a5a5a5; }
                .invoice-meta td { padding: 4px 8px; }
                .invoice-meta .label { width: 22%; color: #444; }
                .invoice-meta .value { font-weight: bold; }
                .invoice-parties td { border: 1px solid #a5a5a5; padding: 6px 8px; vertical-align: top; }
                .section-head { background: #f1f2f4; font-weight: bold; }
                .invoice-lines th, .invoice-lines td { border: 1px solid #a5a5a5; padding: 6px 7px; }
                .invoice-lines th { background: #f1f2f4; text-align: left; }
                .right { text-align: right !important; }
                .center { text-align: center !important; }
                .invoice-summary td { padding: 5px 8px; }
                .invoice-total { font-size: 12pt; font-weight: bold; }
                .invoice-words { width: 58%; vertical-align: top; padding: 10px 8px; }
                .invoice-totals { width: 42%; vertical-align: top; border-left: 1px solid #a5a5a5; }
                .notes { white-space: pre-line; margin-top: 12px; }
                .payslip { font-size: 10pt; color: #181818; }
                .rupee { vertical-align: middle; }
                .payslip-top { border-bottom: 1px solid #d2d2d2; }
                .payslip-top td { vertical-align: middle; padding: 12px 5px; }
                .payslip-logo { text-align: center; border-right: 1px solid #d2d2d2; padding-right: 10px !important; }
                .payslip-company { font-size: 16pt; font-weight: bold; white-space: nowrap; }
                .payslip-month { text-align: right; line-height: 1.5; }
                .payslip-title { background: #f3f3f3; text-align: center; margin: 4px 0 7px; padding: 5px 4px 6px; }
                .payslip-title strong { display: block; font-size: 22pt; line-height: 1.1; }
                .payslip-title span { font-size: 8pt; letter-spacing: 2.5px; }
                .summary-cards { margin-bottom: 7px; table-layout: fixed; }
                .summary-cards, .employee-details, .payable { page-break-inside: avoid; }
                .summary-panel { vertical-align: top; padding: 0; border: 0; border-bottom: 1px solid #dedede; }
                .summary-gap { padding: 0; border: 0; border-bottom: 1px solid #dedede; }
                .summary-card td { border-bottom: 0; padding: 4px 8px; }
                .summary-card tr:last-child td { border-bottom: 0; }
                .card-heading { background: transparent; color: #686868; font-weight: bold; padding: 0 8px 6px !important; }
                .employee-summary .field-label { width: 42%; background: transparent; color: #686868; border-right: 0; }
                .field-colon { float: right; color: #777; }
                .employee-summary .field-value { font-weight: normal; border-left: 0; }
                .summary-spacer td { height: 10px; padding: 0; }
                .net-heading { background: transparent; color: #686868; font-weight: bold; padding: 0 5px 5px !important; }
                .net-value { background: #f3f3f3; text-align: center; font-size: 25pt; font-weight: bold; padding: 8px 4px !important; white-space: nowrap; }
                .amount-words { padding: 5px 5px !important; line-height: 1.35; }
                .amount-words strong { display: block; color: #181818; }
                .days-label { background: transparent; color: #686868; width: 55%; border-right: 0; }
                .days-value { text-align: right; color: #686868; width: 45%; border-left: 0; padding-right: 8px !important; }
                .employee-details { border: 0; border-bottom: 1px solid #dedede; margin-bottom: 7px; }
                .employee-details td { border: 0; padding: 4px 7px; }
                .employee-details .field-label { background: transparent; color: #686868; }
                .employee-details .field-value { white-space: nowrap; }
                .pay-table { border: 1px solid #555; table-layout: fixed; margin-bottom: 7px; page-break-inside: auto; }
                .pay-table thead { display: table-header-group; }
                .pay-table th, .pay-table td { border: 1px solid #d2d2d2; padding: 8px 6px; }
                .pay-table th { background: #777; color: #fff; text-align: left; }
                .pay-table th.amount { text-align: center; white-space: nowrap; }
                .pay-table td.amount { text-align: right; white-space: nowrap; }
                .pay-table .totals-row { background: #f2f2f2; font-weight: bold; }
                .pay-table .pay-gutter { width: 2%; border: 0; padding: 0; background: #fff; }
                .payable { border: 1px solid #d0d0d0; margin-bottom: 7px; }
                .payable td { border: 1px solid #d2d2d2; padding: 12px 9px; }
                .payable-title { font-size: 15pt; }
                .payable-amount { background: #f2f2f2; text-align: center; font-size: 23pt; font-weight: bold; white-space: nowrap; }
                .footer { border-top: 1px solid #d0d0d0; margin-top: 2px; padding-top: 9px; color: #777; text-align: center; font-size: 8pt; }
                .confidentiality { margin-top: 8px; font-size: 8pt; color: #666; }
            </style>
        </head>
        <body>
            <apex:outputPanel layout="block" rendered="{!isInvoice}">
                <table class="invoice-box">
                    <tr class="invoice-head">
                        <td colspan="2"><div class="brand">SELEGIC INDIA PRIVATE LIMITED</div><div class="muted">Monthly office expense request</div></td>
                        <td colspan="2" class="invoice-title">MONTHLY OFFICE INVOICE</td>
                    </tr>
                    <tr><td colspan="4" style="padding:0"><table class="invoice-meta">
                        <tr><td class="label">Invoice #</td><td class="value"><apex:outputText value="{!invoice.invoiceNumber}" escape="true"/></td><td class="label">Invoice Date</td><td class="value"><apex:outputText value="{!invoice.invoiceDate}" escape="true"/></td></tr>
                        <tr><td class="label">Expense Period</td><td class="value"><apex:outputText value="{!invoice.period}" escape="true"/></td><td class="label">Prepared By</td><td class="value"><apex:outputText value="{!invoice.preparedBy}" escape="true"/></td></tr>
                    </table></td></tr>
                    <tr class="invoice-parties section-head"><td width="50%">Prepared For</td><td width="50%">Office</td></tr>
                    <tr class="invoice-parties"><td><apex:outputText value="{!invoice.recipient}" escape="true"/></td><td>Selegic India Private Limited<br/>Webel IT Park, Newtown, Kolkata 700160, India</td></tr>
                    <tr><td colspan="4" style="padding:0"><table class="invoice-lines">
                        <tr><th width="8%" class="center">#</th><th>Description</th><th width="30%" class="right">Amount (INR)</th></tr>
                        <apex:repeat value="{!invoice.lines}" var="line"><tr><td class="center"><apex:outputText value="{!line.lineNumber}"/></td><td><apex:outputText value="{!line.description}" escape="true"/></td><td class="right">₹<apex:outputText value="{!line.amountFormatted}" escape="true"/></td></tr></apex:repeat>
                    </table></td></tr>
                    <tr><td class="invoice-words">Notes<br/><strong><apex:outputText value="{!invoice.notes}" escape="true"/></strong></td><td colspan="3" class="invoice-totals"><table class="invoice-summary"><tr class="invoice-total"><td>Total Office Expenses</td><td class="right">₹<apex:outputText value="{!invoice.totalFormatted}" escape="true"/></td></tr></table></td></tr>
                </table>
            </apex:outputPanel>

            <apex:outputPanel layout="block" rendered="{!isPayslip}">
                <div class="payslip">
                    <table class="payslip-top">
                        <tr>
                            <td class="payslip-logo" width="23%"><apex:image value="{!$Resource.SelegicLogo}" width="125" alt="Selegic"/></td>
                            <td width="51%"><div class="payslip-company">Selegic India Private Limited</div><div class="muted">Webel IT Park, PH-2, DH Block Action Area 1D,<br/>Newtown Kolkata – 700160, India</div></td>
                            <td class="payslip-month" width="26%"><span class="muted">Payslip For the Month</span><br/><strong><apex:outputText value="{!payslip.payPeriod}" escape="true"/></strong></td>
                        </tr>
                    </table>
                    <div class="payslip-title"><strong>SALARY SLIP</strong><span>CONFIDENTIAL EMPLOYEE DOCUMENT</span></div>
                    <table class="summary-cards">
                        <tr>
                            <td class="summary-panel" width="49%">
                                <table class="summary-card employee-summary">
                                    <tr><td colspan="2" class="card-heading">EMPLOYEE SUMMARY</td></tr>
                                    <tr><td class="field-label">Employee Name <span class="field-colon">:</span></td><td class="field-value"><apex:outputText value="{!payslip.employeeName}" escape="true"/></td></tr>
                                    <tr><td class="field-label">Employee ID <span class="field-colon">:</span></td><td class="field-value"><apex:outputText value="{!payslip.employeeId}" escape="true"/></td></tr>
                                    <tr><td class="field-label">Designation <span class="field-colon">:</span></td><td class="field-value"><apex:outputText value="{!payslip.designation}" escape="true"/></td></tr>
                                    <tr><td class="field-label">Pay Period <span class="field-colon">:</span></td><td class="field-value"><apex:outputText value="{!payslip.payPeriod}" escape="true"/></td></tr>
                                    <tr><td class="field-label">Pay Date <span class="field-colon">:</span></td><td class="field-value"><apex:outputText value="{!payslip.payDate}" escape="true"/></td></tr>
                                    <tr class="summary-spacer"><td colspan="2"></td></tr>
                                </table>
                            </td>
                            <td width="2%" class="summary-gap"></td>
                            <td class="summary-panel" width="49%">
                                <table class="summary-card">
                                    <tr><td colspan="2" class="net-heading">NET SALARY PAYABLE</td></tr>
                                    <tr><td colspan="2" class="net-value"><apex:image value="{!$Resource.PayslipRupeeSymbol}" height="21" styleClass="rupee" alt="₹"/>&#160;<apex:outputText value="{!payslip.netPayFormatted}" escape="true"/></td></tr>
                                    <tr><td colspan="2" class="amount-words"><span class="muted">Amount in words:</span><strong><apex:outputText value="{!payslip.amountInWords}" escape="true"/></strong></td></tr>
                                    <tr><td class="days-label">Paid Days</td><td class="days-value"><apex:outputText value="{!payslip.paidDays}" escape="true"/></td></tr>
                                    <tr><td class="days-label">LOP Days</td><td class="days-value"><apex:outputText value="{!payslip.lopDays}" escape="true"/></td></tr>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <table class="employee-details">
                        <tr><td colspan="4" class="card-heading">EMPLOYEE DETAILS</td></tr>
                        <tr><td class="field-label" width="24%">PF Number <span class="field-colon">:</span></td><td class="field-value" width="32%"><apex:outputText value="{!payslip.pfNumber}" escape="true"/></td><td class="field-label" width="21%">UAN Number <span class="field-colon">:</span></td><td class="field-value" width="23%"><apex:outputText value="{!payslip.uanNumber}" escape="true"/></td></tr>
                        <tr><td class="field-label">PAN <span class="field-colon">:</span></td><td class="field-value"><apex:outputText value="{!payslip.pan}" escape="true"/></td><td class="field-label">Date of Joining <span class="field-colon">:</span></td><td class="field-value"><apex:outputText value="{!payslip.dateOfJoining}" escape="true"/></td></tr>
                        <tr><td class="field-label">Bank A/C Number <span class="field-colon">:</span></td><td class="field-value"><apex:outputText value="{!payslip.bankAccountNumber}" escape="true"/></td><td class="field-label"></td><td class="field-value"></td></tr>
                    </table>

                    <table class="pay-table">
                        <thead><tr>
                            <th width="34%">EARNINGS</th><th class="amount" width="15%">AMOUNT (<apex:image value="{!$Resource.PayslipRupeeSymbolWhite}" height="6" styleClass="rupee" alt="₹"/>)</th><td class="pay-gutter"></td><th width="34%">DEDUCTIONS</th><th class="amount" width="15%">AMOUNT (<apex:image value="{!$Resource.PayslipRupeeSymbolWhite}" height="6" styleClass="rupee" alt="₹"/>)</th>
                        </tr></thead>
                        <tbody>
                            <apex:repeat value="{!payRows}" var="row"><tr><td><apex:outputText value="{!row.earning.description}" escape="true" rendered="{!row.hasEarning}"/></td><td class="amount"><apex:outputText value="{!row.earning.amountFormatted}" escape="true" rendered="{!row.hasEarning}"/></td><td class="pay-gutter"></td><td><apex:outputText value="{!row.deduction.description}" escape="true" rendered="{!row.hasDeduction}"/></td><td class="amount"><apex:outputText value="{!row.deduction.amountFormatted}" escape="true" rendered="{!row.hasDeduction}"/></td></tr></apex:repeat>
                            <tr class="totals-row"><td>Gross Earnings</td><td class="amount"><apex:outputText value="{!payslip.grossFormatted}" escape="true"/></td><td class="pay-gutter"></td><td>Total Deductions</td><td class="amount"><apex:outputText value="{!payslip.deductionsFormatted}" escape="true"/></td></tr>
                        </tbody>
                    </table>

                    <table class="payable"><tr><td width="67%"><strong class="payable-title">TOTAL NET PAYABLE</strong><br/><span class="muted">Gross Earnings - Total Deductions</span></td><td class="payable-amount"><apex:image value="{!$Resource.PayslipRupeeSymbol}" height="21" styleClass="rupee" alt="₹"/>&#160;<apex:outputText value="{!payslip.netPayFormatted}" escape="true"/></td></tr></table>
                    <div class="footer">This is a system-generated document.</div>
                    <div class="confidentiality"><strong>Confidentiality:</strong> This payslip contains confidential employee payroll and banking information. Share only with authorised recipients.</div>
                </div>
            </apex:outputPanel>
        </body>
    </html>
</apex:page>
