<apex:page controller="PayrollDocumentPdfController" renderAs="pdf" showHeader="false" sidebar="false" standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false">
    <html>
        <head>
            <meta charset="UTF-8"/>
            <style type="text/css">
                @page { size: A4; margin: {!IF(isPayslip, '18mm 14mm 15mm', '16mm 14mm')}; }
                body { font-family: Arial, Helvetica, sans-serif; color: #181818; font-size: 10pt; }
                .payslip-body { margin: 0; }
                table { width: 100%; border-collapse: collapse; }
                .brand { font-size: 20pt; font-weight: bold; }
                .green { color: #4caf5a; }
                .muted { color: #686868; }
                .invoice-head td { vertical-align: bottom; padding: 8px; }
                .invoice-title { font-size: 23pt; text-align: right; }
                .invoice-box { border: 1px solid #a5a5a5; }
                .invoice-meta td { padding: 4px 8px; }
                .invoice-meta .label { width: 22%; color: #444; }
                .invoice-meta .value { font-weight: bold; }
                .invoice-parties td { border: 1px solid #a5a5a5; padding: 6px 8px; vertical-align: top; }
                .section-head { background: #f1f2f4; font-weight: bold; }
                .invoice-lines th, .invoice-lines td { border: 1px solid #a5a5a5; padding: 6px 7px; }
                .invoice-lines th { background: #f1f2f4; text-align: left; }
                .right { text-align: right !important; }
                .center { text-align: center !important; }
                .invoice-summary td { padding: 5px 8px; }
                .invoice-total { font-size: 12pt; font-weight: bold; }
                .invoice-words { width: 58%; vertical-align: top; padding: 10px 8px; }
                .invoice-totals { width: 42%; vertical-align: top; border-left: 1px solid #a5a5a5; }
                .notes { white-space: pre-line; margin-top: 12px; }
                .payslip-watermark { position: fixed; top: 39%; left: 17.5%; width: 65%; opacity: 0.6; z-index: 0; }
                .payslip-frame { border: 1px solid #999; box-sizing: border-box; min-height: 262mm; position: relative; z-index: 1; }
                .payslip { color: #171717; font-family: Arial, Helvetica, sans-serif; font-size: 9pt; position: relative; z-index: 2; padding-bottom: 24mm; }
                .payslip-head { border-bottom: 1px solid #999; table-layout: fixed; }
                .payslip-head td { padding: 7px 5px 8px; vertical-align: middle; }
                .payslip-logo { border-right: 1px solid #999; padding-right: 7px !important; text-align: center; }
                .payslip-company { font-size: 14pt; font-weight: bold; white-space: nowrap; }
                .payslip-address { font-size: 9pt; line-height: 1.3; }
                .payslip-document-title { font-size: 25pt; font-weight: normal; text-align: right; white-space: nowrap; }
                .payslip-period { font-size: 10pt; font-weight: bold; margin-top: 4px; text-align: right; }
                .payslip-confidential-label { color: #4f4f4f; font-size: 7.2pt; margin-top: 3px; text-align: right; }
                .payslip-section { border: 1px solid #999; margin-top: 0; page-break-inside: avoid; table-layout: fixed; }
                .payslip-section th { background: #f0f0f0; border: 1px solid #999; font-size: 9pt; font-weight: bold; padding: 4px 6px; text-align: left; }
                .payslip-section > tbody > tr > td { border: 1px solid #999; padding: 5px 6px; vertical-align: top; }
                .field-list { border: 0; table-layout: fixed; width: 100%; }
                .field-list td { border: 0; line-height: 1.25; padding: 3px 2px; vertical-align: top; }
                .field-label { color: #171717; font-weight: bold; }
                .field-colon { text-align: center; }
                .field-value { color: #171717; font-weight: normal; }
                .employee-details { margin-top: 0; page-break-inside: avoid; }
                .employee-details .detail-panel { padding: 3px 5px !important; }
                .pay-table { margin-top: 0; page-break-inside: avoid; table-layout: fixed; }
                .pay-table thead { display: table-header-group; }
                .pay-table th, .pay-table td { border: 1px solid #999; padding: 5px 6px; }
                .pay-table th { background: #f0f0f0; color: #171717; font-size: 9pt; font-weight: bold; text-align: left; }
                .pay-table th.amount, .pay-table td.amount { text-align: right; white-space: nowrap; }
                .pay-table .totals-row { background: #f0f0f0; }
                .pay-table .totals-row td:first-child, .pay-table .totals-row td:nth-child(3) { font-weight: bold; }
                .payslip-total { border: 1px solid #999; margin-top: 0; page-break-inside: avoid; table-layout: fixed; }
                .words-cell { border-right: 1px solid #999; padding: 8px; vertical-align: top; }
                .words-title { font-weight: bold; margin-bottom: 7px; }
                .words-value { font-weight: normal; }
                .calculation { color: #4f4f4f; font-size: 8pt; margin-top: 11px; }
                .totals-cell { padding: 4px 7px; vertical-align: top; }
                .totals-summary { width: 100%; }
                .totals-summary td { border: 0; font-size: 9pt; padding: 3px 2px; }
                .totals-summary .amount { text-align: right; white-space: nowrap; }
                .totals-summary .net-total td { background: #e8f2e5; border-top: 1px solid #b0b0b0; font-size: 11pt; font-weight: bold; padding-top: 6px; }
                .totals-summary .net-total .amount { font-size: 10.5pt; }
                .confidentiality { border-top: 1px solid #b8b8b8; color: #666; font-size: 8pt; margin: 13px 0 0; padding: 6px 5px 0; }
                .footer { background: #fff; border-top: 1px solid #999; bottom: 3mm; color: #666; font-size: 8pt; left: 0; padding-top: 5px; position: absolute; right: 0; text-align: center; }
            </style>
        </head>
        <body class="{!IF(isPayslip, 'payslip-body', 'invoice-body')}">
            <apex:outputPanel layout="block" rendered="{!isInvoice}">
                <table class="invoice-box">
                    <tr class="invoice-head">
                        <td colspan="2"><div class="brand">SELEGIC INDIA PRIVATE LIMITED</div><div class="muted">Monthly office expense request</div></td>
                        <td colspan="2" class="invoice-title">MONTHLY OFFICE INVOICE</td>
                    </tr>
                    <tr><td colspan="4" style="padding:0"><table class="invoice-meta">
                        <tr><td class="label">Invoice #</td><td class="value"><apex:outputText value="{!invoice.invoiceNumber}" escape="true"/></td><td class="label">Invoice Date</td><td class="value"><apex:outputText value="{!invoice.invoiceDate}" escape="true"/></td></tr>
                        <tr><td class="label">Expense Period</td><td class="value"><apex:outputText value="{!invoice.period}" escape="true"/></td><td class="label">Prepared By</td><td class="value"><apex:outputText value="{!invoice.preparedBy}" escape="true"/></td></tr>
                    </table></td></tr>
                    <tr class="invoice-parties section-head"><td width="50%">Prepared For</td><td width="50%">Office</td></tr>
                    <tr class="invoice-parties"><td><apex:outputText value="{!invoice.recipient}" escape="true"/></td><td>Selegic India Private Limited<br/>Webel IT Park, Newtown, Kolkata 700160, India</td></tr>
                    <tr><td colspan="4" style="padding:0"><table class="invoice-lines">
                        <tr><th width="8%" class="center">#</th><th>Description</th><th width="30%" class="right">Amount (INR)</th></tr>
                        <apex:repeat value="{!invoice.lines}" var="line"><tr><td class="center"><apex:outputText value="{!line.lineNumber}"/></td><td><apex:outputText value="{!line.description}" escape="true"/></td><td class="right">₹<apex:outputText value="{!line.amountFormatted}" escape="true"/></td></tr></apex:repeat>
                    </table></td></tr>
                    <tr><td class="invoice-words">Notes<br/><strong><apex:outputText value="{!invoice.notes}" escape="true"/></strong></td><td colspan="3" class="invoice-totals"><table class="invoice-summary"><tr class="invoice-total"><td>Total Office Expenses</td><td class="right">₹<apex:outputText value="{!invoice.totalFormatted}" escape="true"/></td></tr></table></td></tr>
                </table>
            </apex:outputPanel>

            <apex:outputPanel layout="block" rendered="{!isPayslip}">
                <apex:image value="{!$Resource.SelegicInvoiceWatermark}" styleClass="payslip-watermark" alt="Selegic watermark"/>
                <div class="payslip-frame">
                    <div class="payslip">
                        <table class="payslip-head">
                            <tr>
                                <td class="payslip-logo" width="17%"><apex:image value="{!$Resource.SelegicLogo}" width="100" alt="Selegic"/></td>
                                <td width="47%"><div class="payslip-company">SELEGIC INDIA PRIVATE LIMITED</div><div class="payslip-address">Webel IT Park, PH-2, DH Block Action Area 1D,<br/>Newtown Kolkata - 700160, India</div></td>
                                <td width="36%"><div class="payslip-document-title">Salary Slip</div><div class="payslip-period"><apex:outputText value="{!payslip.payPeriod}" escape="true"/></div><div class="payslip-confidential-label">CONFIDENTIAL EMPLOYEE DOCUMENT</div></td>
                            </tr>
                        </table>

                        <table class="payslip-section summary-grid">
                            <thead><tr><th width="50%">EMPLOYEE SUMMARY</th><th width="50%">PAY DETAILS</th></tr></thead>
                            <tbody><tr>
                                <td><table class="field-list">
                                    <tr><td class="field-label" width="38%">Employee Name</td><td class="field-colon" width="4%">:</td><td class="field-value" width="58%"><apex:outputText value="{!payslip.employeeName}" escape="true"/></td></tr>
                                    <tr><td class="field-label">Employee ID</td><td class="field-colon">:</td><td class="field-value"><apex:outputText value="{!payslip.employeeId}" escape="true"/></td></tr>
                                    <tr><td class="field-label">Designation</td><td class="field-colon">:</td><td class="field-value"><apex:outputText value="{!payslip.designation}" escape="true"/></td></tr>
                                </table></td>
                                <td><table class="field-list">
                                    <tr><td class="field-label" width="38%">Pay Period</td><td class="field-colon" width="4%">:</td><td class="field-value" width="58%"><apex:outputText value="{!payslip.payPeriod}" escape="true"/></td></tr>
                                    <tr><td class="field-label">Pay Date</td><td class="field-colon">:</td><td class="field-value"><apex:outputText value="{!payslip.payDate}" escape="true"/></td></tr>
                                    <tr><td class="field-label">Paid Days</td><td class="field-colon">:</td><td class="field-value"><apex:outputText value="{!payslip.paidDays}" escape="true"/></td></tr>
                                    <tr><td class="field-label">LOP Days</td><td class="field-colon">:</td><td class="field-value"><apex:outputText value="{!payslip.lopDays}" escape="true"/></td></tr>
                                </table></td>
                            </tr></tbody>
                        </table>

                        <table class="payslip-section employee-details">
                            <thead><tr><th colspan="2">EMPLOYEE DETAILS</th></tr></thead>
                            <tbody><tr>
                                <td class="detail-panel" width="50%"><table class="field-list">
                                    <tr><td class="field-label" width="38%">PF Number</td><td class="field-colon" width="4%">:</td><td class="field-value" width="58%"><apex:outputText value="{!payslip.pfNumber}" escape="true"/></td></tr>
                                    <tr><td class="field-label">PAN</td><td class="field-colon">:</td><td class="field-value"><apex:outputText value="{!payslip.pan}" escape="true"/></td></tr>
                                    <tr><td class="field-label">Bank A/C Number</td><td class="field-colon">:</td><td class="field-value"><apex:outputText value="{!payslip.bankAccountNumber}" escape="true"/></td></tr>
                                </table></td>
                                <td class="detail-panel" width="50%"><table class="field-list">
                                    <tr><td class="field-label" width="38%">UAN Number</td><td class="field-colon" width="4%">:</td><td class="field-value" width="58%"><apex:outputText value="{!payslip.uanNumber}" escape="true"/></td></tr>
                                    <tr><td class="field-label">Date of Joining</td><td class="field-colon">:</td><td class="field-value"><apex:outputText value="{!payslip.dateOfJoining}" escape="true"/></td></tr>
                                </table></td>
                            </tr></tbody>
                        </table>

                        <table class="pay-table">
                            <colgroup><col width="34%"/><col width="16%"/><col width="34%"/><col width="16%"/></colgroup>
                            <thead><tr>
                                <th>Earnings</th><th class="amount">Amount ( INR )</th>
                                <th>Deductions</th><th class="amount">Amount ( INR )</th>
                            </tr></thead>
                            <tbody>
                                <apex:repeat value="{!payRows}" var="row"><tr>
                                    <td><apex:outputText value="{!row.earning.description}" escape="true" rendered="{!row.hasEarning}"/></td>
                                    <td class="amount"><apex:outputText value="{!row.earning.amountFormatted}" escape="true" rendered="{!row.hasEarning}"/></td>
                                    <td><apex:outputText value="{!row.deduction.description}" escape="true" rendered="{!row.hasDeduction}"/></td>
                                    <td class="amount"><apex:outputText value="{!row.deduction.amountFormatted}" escape="true" rendered="{!row.hasDeduction}"/></td>
                                </tr></apex:repeat>
                                <tr class="totals-row"><td>Gross Earnings</td><td class="amount"><apex:outputText value="{!payslip.grossFormatted}" escape="true"/></td><td>Total Deductions</td><td class="amount"><apex:outputText value="{!payslip.deductionsFormatted}" escape="true"/></td></tr>
                            </tbody>
                        </table>

                        <apex:outputPanel layout="none" rendered="{!payslip.hasBonuses}">
                        <table class="payslip-section pay-table">
                            <colgroup><col width="28%"/><col width="22%"/><col width="25%"/><col width="25%"/></colgroup>
                            <thead><tr>
                                <th><apex:outputText value="{!payslip.bonusTitle}" escape="true"/></th><th class="amount">Bonus Amount</th>
                                <th class="amount">TDS Deducted</th><th class="amount"><apex:outputText value="{!payslip.netBonusLabel}" escape="true"/></th>
                            </tr></thead>
                            <tbody>
                                <apex:repeat value="{!payslip.bonuses}" var="bonus"><tr>
                                    <td><apex:outputText value="{!bonus.description}" escape="true"/></td>
                                    <td class="amount">INR&#160;<apex:outputText value="{!bonus.amountFormatted}" escape="true"/></td>
                                    <td class="amount"><apex:outputText value="{!bonus.tdsLabel}" escape="true"/><br/>INR&#160;<apex:outputText value="{!bonus.tdsAmountFormatted}" escape="true"/></td>
                                    <td class="amount"><apex:outputText value="{!bonus.netLabel}" escape="true"/><br/>INR&#160;<apex:outputText value="{!bonus.netAmountFormatted}" escape="true"/></td>
                                </tr></apex:repeat>
                            </tbody>
                        </table>
                        </apex:outputPanel>

                        <table class="payslip-total">
                            <tr>
                                <td class="words-cell" width="58%"><div class="words-title">Amount in Words</div><div class="words-value"><apex:outputText value="{!payslip.amountInWords}" escape="true"/></div><div class="calculation"><apex:outputText value="{!payslip.calculationLabel}" escape="true"/></div></td>
                                <td class="totals-cell" width="42%"><table class="totals-summary">
                                    <tr><td><strong>Gross Earnings</strong></td><td class="amount"><apex:outputText value="{!payslip.grossFormatted}" escape="true"/></td></tr>
                                    <tr><td><strong>Total Deductions</strong></td><td class="amount"><apex:outputText value="{!payslip.deductionsFormatted}" escape="true"/></td></tr>
                                    <tr class="net-total"><td>TOTAL NET PAYABLE</td><td class="amount">INR&#160;<apex:outputText value="{!payslip.netPayFormatted}" escape="true"/></td></tr>
                                </table></td>
                            </tr>
                        </table>
                        <div class="confidentiality"><strong>Confidentiality:</strong> This payslip contains confidential employee payroll and banking information. Share only with authorised recipients.</div>
                    </div>
                    <div class="footer">This is a system-generated document.</div>
                </div>
            </apex:outputPanel>
        </body>
    </html>
</apex:page>
