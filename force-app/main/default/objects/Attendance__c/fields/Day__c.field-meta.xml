<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Day__c</fullName>
    <description>Automatically determines the day of the week from the Attendance Date.</description>
    <externalId>false</externalId>
    <formula>CASE(
    MOD(Attendance_Date__c - DATE(1900, 1, 7), 7),
    0, &quot;Sunday&quot;,
    1, &quot;Monday&quot;,
    2, &quot;Tuesday&quot;,
    3, &quot;Wednesday&quot;,
    4, &quot;Thursday&quot;,
    5, &quot;Friday&quot;,
    6, &quot;Saturday&quot;,
    &quot;Unknown&quot;
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>The day of the week is automatically calculated from the Attendance Date.</inlineHelpText>
    <label>Day</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
